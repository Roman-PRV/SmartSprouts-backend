								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [
							{ "key": "Accept", "value": "application/json" },
							{ "key": "Accept-Language", "value": "uk" }
						],
						"url": {
							"raw": "{{base_url}}/api/games/{{mul_game_id}}/levels/{{mul_level_id}}",
							"host": ["{{base_url}}"],
							"path": ["api", "games", "{{mul_game_id}}", "levels", "{{mul_level_id}}"]
						}
					}
				}
			]
		},
		{
			"name": "2. Happy Path",
			"item": [
				{
					"name": "Submit attempt — all correct (perfect score)",
					"event": [
						{
							"listen": "prerequest",
							"script": {
								"exec": [
									"const eqs = JSON.parse(pm.collectionVariables.get('equations') || '[]');",
									"if (eqs.length === 0) throw new Error('No equations — run Discovery first');",
									"const answers = eqs.map(e => ({ equation_id: e.id, answer: e.result }));",
									"pm.variables.set('request_payload', JSON.stringify({ answers }));"
								],
								"type": "text/javascript"
							}
						},
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('200 OK', () => pm.response.to.have.status(200));",
									"const body = pm.response.json();",
									"const count = Number(pm.collectionVariables.get('facts_count'));",
									"pm.test('results length matches level', () => pm.expect(body.results).to.have.lengthOf(count));",
									"pm.test('every answer is correct', () => pm.expect(body.results.every(r => r.correct === true)).to.be.true);",
									"const r0 = body.results[0];",
									"pm.test('result has expected fields', () => {",
									"  pm.expect(r0).to.have.property('equation_id');",
									"  pm.expect(r0).to.have.property('operand_a');",
									"  pm.expect(r0).to.have.property('operand_b');",
									"  pm.expect(r0).to.have.property('operator');",
									"  pm.expect(r0).to.have.property('given_answer');",
									"  pm.expect(r0).to.have.property('expected_answer');",
									"  pm.expect(r0).to.have.property('correct');",
									"});",
									"console.log('All', count, 'answers correct. Score persisted server-side (no score in body).');"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Accept", "value": "application/json" },
							{ "key": "Accept-Language", "value": "en" }
						],
						"body": {
							"mode": "raw",
							"raw": "{{request_payload}}"
						},
						"url": {
							"raw": "{{base_url}}/api/games/{{mul_game_id}}/levels/{{mul_level_id}}/attempts",
							"host": ["{{base_url}}"],
							"path": ["api", "games", "{{mul_game_id}}", "levels", "{{mul_level_id}}", "attempts"]
						}
					}
				},
				{
					"name": "Submit attempt — all wrong (zero score)",
					"event": [
						{
							"listen": "prerequest",
							"script": {
								"exec": [
									"const eqs = JSON.parse(pm.collectionVariables.get('equations') || '[]');",
									"if (eqs.length === 0) throw new Error('No equations — run Discovery first');",
									"// Off-by-one answer for every fact — full coverage, all wrong.",
									"const answers = eqs.map(e => ({ equation_id: e.id, answer: e.result + 1 }));",
									"pm.variables.set('request_payload', JSON.stringify({ answers }));"
								],
								"type": "text/javascript"
							}
						},
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('200 OK', () => pm.response.to.have.status(200));",
									"const body = pm.response.json();",
									"pm.test('every answer is wrong', () => pm.expect(body.results.every(r => r.correct === false)).to.be.true);",
									"console.log('Zero correct. game_results score should be 0.');"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Accept", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{{request_payload}}"
						},
						"url": {
							"raw": "{{base_url}}/api/games/{{mul_game_id}}/levels/{{mul_level_id}}/attempts",
							"host": ["{{base_url}}"],
							"path": ["api", "games", "{{mul_game_id}}", "levels", "{{mul_level_id}}", "attempts"]
						}
					}
				},
				{
					"name": "Submit attempt — mixed (one wrong)",
					"event": [
						{
							"listen": "prerequest",
							"script": {
								"exec": [
									"const eqs = JSON.parse(pm.collectionVariables.get('equations') || '[]');",
									"if (eqs.length === 0) throw new Error('No equations — run Discovery first');",
									"// First fact deliberately wrong, the rest correct.",
									"const answers = eqs.map((e, i) => ({ equation_id: e.id, answer: i === 0 ? e.result + 7 : e.result }));",
									"pm.variables.set('request_payload', JSON.stringify({ answers }));"
								],
								"type": "text/javascript"
							}
						},
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('200 OK', () => pm.response.to.have.status(200));",
									"const body = pm.response.json();",
									"const count = Number(pm.collectionVariables.get('facts_count'));",
									"pm.test('first answer wrong', () => pm.expect(body.results[0].correct).to.equal(false));",
									"const correct = body.results.filter(r => r.correct).length;",
									"pm.test('exactly one wrong', () => pm.expect(correct).to.equal(count - 1));"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Accept", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{{request_payload}}"
						},
						"url": {
							"raw": "{{base_url}}/api/games/{{mul_game_id}}/levels/{{mul_level_id}}/attempts",
							"host": ["{{base_url}}"],
							"path": ["api", "games", "{{mul_game_id}}", "levels", "{{mul_level_id}}", "attempts"]
						}
					}
				},
				{
					"name": "Submit attempt — Ukrainian locale (persists locale)",
					"event": [
						{
							"listen": "prerequest",
							"script": {
								"exec": [
									"const eqs = JSON.parse(pm.collectionVariables.get('equations') || '[]');",
									"if (eqs.length === 0) throw new Error('No equations — run Discovery first');",
									"const answers = eqs.map(e => ({ equation_id: e.id, answer: e.result }));",
									"pm.variables.set('request_payload', JSON.stringify({ answers }));"
								],
								"type": "text/javascript"
							}
						},
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('200 OK', () => pm.response.to.have.status(200));",
									"console.log('Submitted with Accept-Language: uk. game_results.locale should be saved as uk.');"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Accept", "value": "application/json" },
							{ "key": "Accept-Language", "value": "uk" }
						],
						"body": {
							"mode": "raw",
							"raw": "{{request_payload}}"
						},
						"url": {
							"raw": "{{base_url}}/api/games/{{mul_game_id}}/levels/{{mul_level_id}}/attempts",
							"host": ["{{base_url}}"],
							"path": ["api", "games", "{{mul_game_id}}", "levels", "{{mul_level_id}}", "attempts"]
						}
					}
				}
			]
		},
		{
			"name": "3. Negative Cases",
			"item": [
				{
					"name": "401 — no token",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('401 Unauthenticated', () => pm.response.to.have.status(401));"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": { "type": "noauth" },
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Accept", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"answers\": []\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/games/{{mul_game_id}}/levels/{{mul_level_id}}/attempts",
							"host": ["{{base_url}}"],
							"path": ["api", "games", "{{mul_game_id}}", "levels", "{{mul_level_id}}", "attempts"]
						}
					}
				},
				{
					"name": "404 — nonexistent game",
					"event": [
						{
							"listen": "prerequest",
							"script": {
								"exec": [
									"const eqs = JSON.parse(pm.collectionVariables.get('equations') || '[]');",
									"const answers = eqs.map(e => ({ equation_id: e.id, answer: e.result }));",
									"pm.variables.set('request_payload', JSON.stringify({ answers }));"
								],
								"type": "text/javascript"
							}
						},
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('404 Not Found', () => pm.response.to.have.status(404));"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Accept", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{{request_payload}}"
						},
						"url": {
							"raw": "{{base_url}}/api/games/999999/levels/{{mul_level_id}}/attempts",
							"host": ["{{base_url}}"],
							"path": ["api", "games", "999999", "levels", "{{mul_level_id}}", "attempts"]
						}
					}
				},
				{
					"name": "404 — nonexistent level (valid full-coverage payload)",
					"event": [
						{
							"listen": "prerequest",
							"script": {
								"exec": [
									"const eqs = JSON.parse(pm.collectionVariables.get('equations') || '[]');",
									"if (eqs.length === 0) throw new Error('No equations — run Discovery first');",
									"// Payload must pass validation (full coverage) so the level guard (404), not validation (422), fires.",
									"const answers = eqs.map(e => ({ equation_id: e.id, answer: e.result }));",
									"pm.variables.set('request_payload', JSON.stringify({ answers }));"
								],
								"type": "text/javascript"
							}
						},
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('404 Not Found', () => pm.response.to.have.status(404));"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Accept", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{{request_payload}}"
						},
						"url": {
							"raw": "{{base_url}}/api/games/{{mul_game_id}}/levels/999/attempts",
							"host": ["{{base_url}}"],
							"path": ["api", "games", "{{mul_game_id}}", "levels", "999", "attempts"]
						}
					}
				},
				{
					"name": "422 — partial coverage (one fact missing)",
					"event": [
						{
							"listen": "prerequest",
							"script": {
								"exec": [
									"const eqs = JSON.parse(pm.collectionVariables.get('equations') || '[]');",
									"if (eqs.length < 2) throw new Error('Need 2+ equations — run Discovery first');",
									"// Drop the last fact — the coverage check must reject an incomplete set.",
									"const answers = eqs.slice(0, -1).map(e => ({ equation_id: e.id, answer: e.result }));",
									"pm.variables.set('request_payload', JSON.stringify({ answers }));"
								],
								"type": "text/javascript"
							}
						},
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('422 Unprocessable', () => pm.response.to.have.status(422));",
									"const body = pm.response.json();",
									"pm.test('unified contract message', () => pm.expect(body.message).to.equal('Validation failed'));",
									"pm.test('error on answers (coverage)', () => pm.expect(body.errors).to.have.property('answers'));"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Accept", "value": "application/json" },
							{ "key": "Accept-Language", "value": "en" }
						],
						"body": {
							"mode": "raw",
							"raw": "{{request_payload}}"
						},
						"url": {
							"raw": "{{base_url}}/api/games/{{mul_game_id}}/levels/{{mul_level_id}}/attempts",
							"host": ["{{base_url}}"],
							"path": ["api", "games", "{{mul_game_id}}", "levels", "{{mul_level_id}}", "attempts"]
						}
					}
				},
				{
					"name": "422 — equation_id out of range (id = 11)",
					"event": [
						{
							"listen": "prerequest",
							"script": {
								"exec": [
									"const eqs = JSON.parse(pm.collectionVariables.get('equations') || '[]');",
									"if (eqs.length === 0) throw new Error('No equations — run Discovery first');",
									"const count = Number(pm.collectionVariables.get('facts_count'));",
									"const answers = eqs.map(e => ({ equation_id: e.id, answer: e.result }));",
									"answers[0].equation_id = count + 1; // outside 1..FACTS_PER_LEVEL",
									"pm.variables.set('request_payload', JSON.stringify({ answers }));"
								],
								"type": "text/javascript"
							}
						},
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('422 Unprocessable', () => pm.response.to.have.status(422));",
									"const body = pm.response.json();",
									"pm.test('error on an answers.*.equation_id', () => {",
									"  const keys = Object.keys(body.errors || {});",
									"  const hit = keys.some(k => k.startsWith('answers.') && k.endsWith('.equation_id'));",
									"  pm.expect(hit).to.be.true;",
									"});"
