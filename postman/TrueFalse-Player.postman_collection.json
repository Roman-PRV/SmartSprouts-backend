{
	"info": {
		"_postman_id": "e5c1a9b7-6d20-4f83-9a41-2c8b7e0d3f19",
		"name": "True/False — Player",
		"description": "[Repointed] Uses the `SmartSprouts — Local` environment; there is no inline login — run the `Auth` collection first so `user_token` is populated.\n\nSmoke tests for the true/false player flow over the shared generic endpoints (read via LevelController, submit via AttemptController). Discovery-based: it finds a true_false_text game, a level that has statements, and plays it — so it runs against existing data with no seeding.\n\nKey point: the player level resource HIDES `is_true` (you must not be able to see the answer before submitting). This collection asserts that privacy, then submits guesses and checks the scoring SHAPE (200 + one result per statement). It cannot assert a perfect score, precisely because the correct answers aren't exposed to the player. The submit RESPONSE does include `is_true` — revealing it after answering is intended.\n\nSubmit body: `{ answers: [ { statement_id, answer(bool) } ] }`.\n\nUsage:\n1. Select the `SmartSprouts — Local` environment (it carries base_url and the tokens).\n2. Run the `Auth` collection first to populate the token.\n3. Run `2. Discovery` top-to-bottom — game_id, level_id, statement_ids auto-saved.\n4. Step through `3. Happy Path`; `4. Negative Cases` for sanity checks.\n\nAll requests inherit Bearer auth via {{user_token}}.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"auth": {
		"type": "bearer",
		"bearer": [
			{
				"key": "token",
				"value": "{{user_token}}",
				"type": "string"
			}
		]
	},
	"event": [
		{
			"listen": "prerequest",
			"script": {
				"type": "text/javascript",
				"exec": [
					"if (!pm.environment.get('user_token')) {",
					"    console.warn('[True/False — Player] user_token is empty — run the \\\"Auth\\\" collection first (1. Tokens).');",
					"}"
				]
			}
		}
	],
	"variable": [
		{
			"key": "statement_ids",
			"value": "[]",
			"type": "string",
			"description": "JSON array of the level's statement ids. Populated by Discovery."
		},
		{
			"key": "request_payload",
			"value": "{}",
			"type": "string",
			"description": "Per-request body built in pre-request scripts."
		}
	],
	"item": [
		{
			"name": "2. Discovery",
			"item": [
				{
					"name": "List games (save true_false_text id)",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('200 OK', () => pm.response.to.have.status(200));",
									"const body = pm.response.json();",
									"const list = Array.isArray(body) ? body : (body.data || []);",
									"const game = list.find(g => g.key === 'true_false_text');",
									"pm.test('true_false_text game exists', () => pm.expect(game).to.exist);",
									"if (game) {",
									"  pm.environment.set('game_id', String(game.id));",
									"  console.log('Saved game_id =', game.id, '| title:', game.title);",
									"}"
								]
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							},
							{
								"key": "Accept-Language",
								"value": "en"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/games",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"games"
							]
						}
					}
				},
				{
					"name": "List levels (save first level id)",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('200 OK', () => pm.response.to.have.status(200));",
									"const body = pm.response.json();",
									"const list = Array.isArray(body) ? body : (body.data || []);",
									"pm.test('at least one level', () => pm.expect(list.length).to.be.greaterThan(0));",
									"if (list.length) {",
									"  pm.environment.set('level_id', String(list[0].id));",
									"  console.log('Saved level_id =', list[0].id, '| title:', list[0].title);",
									"}"
								]
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							},
							{
								"key": "Accept-Language",
								"value": "en"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/games/{{game_id}}/levels",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"games",
								"{{game_id}}",
								"levels"
							]
						}
					}
				},
				{
					"name": "Get level with statements (save statement_ids + privacy check)",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('200 OK', () => pm.response.to.have.status(200));",
									"const body = pm.response.json();",
									"const statements = body.statements || [];",
									"pm.test('level has statements', () => pm.expect(statements.length, 'pick a level that has statements').to.be.greaterThan(0));",
									"pm.test('statement has id + text', () => {",
									"  pm.expect(statements[0]).to.have.property('id');",
									"  pm.expect(statements[0]).to.have.property('statement');",
									"});",
									"// PRIVACY: the answer must never reach the player before submitting.",
									"pm.test('player statement HIDES is_true', () => pm.expect(statements[0]).to.not.have.property('is_true'));",
									"pm.collectionVariables.set('statement_ids', JSON.stringify(statements.map(s => s.id)));",
									"console.log('Saved', statements.length, 'statement id(s).');"
								]
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							},
							{
								"key": "Accept-Language",
								"value": "en"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/games/{{game_id}}/levels/{{level_id}}",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"games",
								"{{game_id}}",
								"levels",
								"{{level_id}}"
							]
						}
					}
				}
			]
		},
		{
			"name": "3. Happy Path",
			"item": [
				{
					"name": "Submit answers — all TRUE (shape check)",
					"event": [
						{
							"listen": "prerequest",
							"script": {
								"type": "text/javascript",
								"exec": [
									"const ids = JSON.parse(pm.collectionVariables.get('statement_ids') || '[]');",
									"if (ids.length === 0) throw new Error('No statements — run Discovery first');",
									"const answers = ids.map(id => ({ statement_id: id, answer: true }));",
									"pm.variables.set('request_payload', JSON.stringify({ answers }));"
								]
							}
						},
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('200 OK', () => pm.response.to.have.status(200));",
									"const body = pm.response.json();",
									"const ids = JSON.parse(pm.collectionVariables.get('statement_ids') || '[]');",
									"pm.test('results is an array', () => pm.expect(body.results).to.be.an('array'));",
									"pm.test('one result per statement', () => pm.expect(body.results).to.have.lengthOf(ids.length));",
									"const r0 = body.results[0];",
									"pm.test('result has statement_id, correct, is_true', () => {",
									"  pm.expect(r0).to.have.property('statement_id');",
									"  pm.expect(r0).to.have.property('correct');",
									"  pm.expect(r0).to.have.property('is_true');",
									"});",
									"pm.test('correct reflects answer vs is_true', () => pm.expect(r0.correct).to.equal(r0.is_true === true));",
									"console.log('Scored', body.results.length, 'statements. Score persisted server-side.');"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Accept",
								"value": "application/json"
							},
							{
								"key": "Accept-Language",
								"value": "en"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{{request_payload}}"
						},
						"url": {
							"raw": "{{base_url}}/api/games/{{game_id}}/levels/{{level_id}}/attempts",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"games",
								"{{game_id}}",
								"levels",
								"{{level_id}}",
								"attempts"
							]
						}
					}
				},
				{
					"name": "Submit answers — all FALSE (shape check)",
					"event": [
						{
							"listen": "prerequest",
							"script": {
								"type": "text/javascript",
								"exec": [
									"const ids = JSON.parse(pm.collectionVariables.get('statement_ids') || '[]');",
									"if (ids.length === 0) throw new Error('No statements — run Discovery first');",
									"const answers = ids.map(id => ({ statement_id: id, answer: false }));",
									"pm.variables.set('request_payload', JSON.stringify({ answers }));"
								]
							}
						},
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('200 OK', () => pm.response.to.have.status(200));",
									"const body = pm.response.json();",
									"const ids = JSON.parse(pm.collectionVariables.get('statement_ids') || '[]');",
									"pm.test('one result per statement', () => pm.expect(body.results).to.have.lengthOf(ids.length));",
									"pm.test('correct reflects answer vs is_true', () => {",
									"  const r0 = body.results[0];",
									"  pm.expect(r0.correct).to.equal(r0.is_true === false);",
									"});"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Accept",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{{request_payload}}"
						},
						"url": {
							"raw": "{{base_url}}/api/games/{{game_id}}/levels/{{level_id}}/attempts",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"games",
								"{{game_id}}",
								"levels",
								"{{level_id}}",
								"attempts"
							]
						}
					}
				}
			]
		},
		{
			"name": "4. Negative Cases",
			"item": [
				{
					"name": "401 — no token",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('401 Unauthenticated', () => pm.response.to.have.status(401));"
								]
							}
						}
					],
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Accept",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"answers\": []\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/games/{{game_id}}/levels/{{level_id}}/attempts",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"games",
								"{{game_id}}",
								"levels",
								"{{level_id}}",
								"attempts"
							]
						}
					}
				},
				{
					"name": "422 — non-boolean answer",
					"event": [
						{
							"listen": "prerequest",
							"script": {
								"type": "text/javascript",
								"exec": [
									"const ids = JSON.parse(pm.collectionVariables.get('statement_ids') || '[]');",
									"if (ids.length === 0) throw new Error('No statements — run Discovery first');",
									"// answer must be a boolean; a string is rejected.",
									"const answers = [{ statement_id: ids[0], answer: 'yes' }];",
									"pm.variables.set('request_payload', JSON.stringify({ answers }));"
								]
							}
						},
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('422 Unprocessable', () => pm.response.to.have.status(422));",
									"const body = pm.response.json();",
									"pm.test('error on an answers.*.answer', () => {",
									"  const keys = Object.keys(body.errors || {});",
									"  const hit = keys.some(k => k.startsWith('answers.') && k.endsWith('.answer'));",
									"  pm.expect(hit).to.be.true;",
									"});"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Accept",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{{request_payload}}"
						},
						"url": {
							"raw": "{{base_url}}/api/games/{{game_id}}/levels/{{level_id}}/attempts",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"games",
								"{{game_id}}",
								"levels",
								"{{level_id}}",
								"attempts"
							]
						}
					}
				},
				{
					"name": "404 — nonexistent level (valid payload)",
					"event": [
						{
							"listen": "prerequest",
							"script": {
								"type": "text/javascript",
								"exec": [
									"const ids = JSON.parse(pm.collectionVariables.get('statement_ids') || '[]');",
									"if (ids.length === 0) throw new Error('No statements — run Discovery first');",
									"const answers = ids.map(id => ({ statement_id: id, answer: true }));",
									"pm.variables.set('request_payload', JSON.stringify({ answers }));"
								]
							}
						},
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('404 Not Found', () => pm.response.to.have.status(404));"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Accept",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{{request_payload}}"
						},
						"url": {
							"raw": "{{base_url}}/api/games/{{game_id}}/levels/99999999/attempts",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"games",
								"{{game_id}}",
								"levels",
								"99999999",
								"attempts"
							]
						}
					}
				}
			]
		}
	]
}
