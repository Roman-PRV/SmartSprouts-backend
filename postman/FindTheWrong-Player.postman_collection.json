{
	"info": {
		"_postman_id": "a3f7c2d1-8b4e-4f9a-bc6d-e2f1a0b3c5d8",
		"name": "Find the Wrong — Player",
		"description": "[Repointed] Uses the `SmartSprouts — Local` environment; there is no inline login — run the `Auth` collection first so `user_token` is populated.\n\nSmoke tests for player-facing endpoints: level read and attempt submit.\n\nAdaptive payloads — Happy Path and Negative Cases build request bodies dynamically based on actual items in the level (works with 1+ items).\n\nUsage:\n1. Select the `SmartSprouts — Local` environment (it carries base_url and the tokens).\n2. Run the `Auth` collection first to populate the token.\n3. Run `1. Discovery` folder top-to-bottom — game_id, level_id, and all_item_ids auto-saved.\n4. Step through `2. Happy Path`.\n5. Use `3. Negative Cases` for sanity checks.\n\nAll requests inherit Bearer auth via {{user_token}}.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"auth": {
		"type": "bearer",
		"bearer": [{ "key": "token", "value": "{{user_token}}", "type": "string" }]
	},
	"event": [
		{
			"listen": "prerequest",
			"script": {
				"type": "text/javascript",
				"exec": [
					"if (!pm.environment.get('user_token')) {",
					"    console.warn('[Find the Wrong — Player] user_token is empty — run the \\\"Auth\\\" collection first (1. Tokens).');",
					"}"
				]
			}
		}
	],
	"variable": [
		{ "key": "ftwp_game_id", "value": "", "type": "string" },
		{ "key": "ftwp_level_id", "value": "", "type": "string" },
		{ "key": "all_item_ids", "value": "[]", "type": "string", "description": "JSON array of every item ID in the level. Populated by Discovery." },
		{ "key": "request_payload", "value": "{}", "type": "string", "description": "Per-request payload built in pre-request scripts. Sent as raw body." }
	],
	"item": [
		{
			"name": "1. Discovery",
			"item": [
				{
					"name": "List games (save find_the_wrong id)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('200 OK', () => pm.response.to.have.status(200));",
									"const body = pm.response.json();",
									"const list = Array.isArray(body) ? body : (body.data || []);",
									"const ftw = list.find(g => g.key === 'find_the_wrong');",
									"pm.test('find_the_wrong game exists', () => pm.expect(ftw).to.exist);",
									"if (ftw) {",
									"  pm.collectionVariables.set('ftwp_game_id', String(ftw.id));",
									"  console.log('Saved game_id =', ftw.id);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [{ "key": "Accept", "value": "application/json" }],
						"url": {
							"raw": "{{base_url}}/api/games",
							"host": ["{{base_url}}"],
							"path": ["api", "games"]
						}
					}
				},
				{
					"name": "List levels (save first level id)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('200 OK', () => pm.response.to.have.status(200));",
									"const body = pm.response.json();",
									"const list = Array.isArray(body) ? body : (body.data || []);",
									"pm.test('at least one level', () => pm.expect(list.length).to.be.greaterThan(0));",
									"if (list.length) {",
									"  pm.collectionVariables.set('ftwp_level_id', String(list[0].id));",
									"  console.log('Saved level_id =', list[0].id);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [{ "key": "Accept", "value": "application/json" }],
						"url": {
							"raw": "{{base_url}}/api/games/{{ftwp_game_id}}/levels",
							"host": ["{{base_url}}"],
							"path": ["api", "games", "{{ftwp_game_id}}", "levels"]
						}
					}
				},
				{
					"name": "Get level with items (save all item IDs)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('200 OK', () => pm.response.to.have.status(200));",
									"const body = pm.response.json();",
									"// Response shape: { id, title, items: [...] } — no `data` wrapping",
									"const items = body.items || body.data?.items || [];",
									"pm.test('at least one item in level', () => pm.expect(items.length).to.be.greaterThan(0));",
									"const ids = items.map(i => i.id);",
									"pm.collectionVariables.set('all_item_ids', JSON.stringify(ids));",
									"console.log('Level has', ids.length, 'item(s):', ids);"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [{ "key": "Accept", "value": "application/json" }],
						"url": {
							"raw": "{{base_url}}/api/games/{{ftwp_game_id}}/levels/{{ftwp_level_id}}",
							"host": ["{{base_url}}"],
							"path": ["api", "games", "{{ftwp_game_id}}", "levels", "{{ftwp_level_id}}"]
						}
					}
				}
			]
		},
		{
			"name": "2. Happy Path",
			"item": [
				{
					"name": "Submit attempt — all found (perfect score)",
					"event": [
						{
							"listen": "prerequest",
							"script": {
								"exec": [
									"const ids = JSON.parse(pm.collectionVariables.get('all_item_ids') || '[]');",
									"if (ids.length === 0) throw new Error('No item IDs — run Discovery first');",
									"const found = ids.map((id, i) => ({ item_id: id, stars: ((i % 3) + 1) }));",
									"pm.variables.set('request_payload', JSON.stringify({",
									"  duration_seconds: 42,",
									"  found,",
									"  missed_item_ids: [],",
									"}));"
								],
								"type": "text/javascript"
							}
						},
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('200 OK', () => pm.response.to.have.status(200));",
									"const body = pm.response.json();",
									"const ids = JSON.parse(pm.collectionVariables.get('all_item_ids') || '[]');",
									"pm.test('score = total_questions', () => pm.expect(body.score).to.equal(body.total_questions));",
									"pm.test('total_questions matches level', () => pm.expect(body.total_questions).to.equal(ids.length));",
									"pm.test('found_items count matches', () => pm.expect(body.found_items).to.have.lengthOf(ids.length));",
									"pm.test('missed_items is empty', () => pm.expect(body.missed_items).to.have.lengthOf(0));",
									"const found0 = body.found_items[0];",
									"pm.test('found item has id, stars, name, explanation', () => {",
									"  pm.expect(found0).to.have.property('id');",
									"  pm.expect(found0).to.have.property('stars');",
									"  pm.expect(found0).to.have.property('name');",
									"  pm.expect(found0).to.have.property('explanation');",
									"});",
									"console.log('Score:', body.score, '/', body.total_questions);"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Accept", "value": "application/json" },
							{ "key": "Accept-Language", "value": "en" }
