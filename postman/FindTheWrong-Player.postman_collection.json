{
	"info": {
		"_postman_id": "a3f7c2d1-8b4e-4f9a-bc6d-e2f1a0b3c5d8",
		"name": "Find the Wrong — Player",
		"description": "Smoke tests for player-facing endpoints: level read and attempt submit.\n\nUsage:\n1. Set `base_url`, `email`, `password` in collection variables (or environment).\n2. Run `1. Auth / Login` — token is auto-saved.\n3. Run `2. Discovery` folder top-to-bottom — game_id, level_id, and item_ids auto-saved.\n4. Step through `3. Happy Path`.\n5. Use `4. Negative Cases` for sanity checks.\n\nAll requests inherit Bearer auth via {{token}}.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"auth": {
		"type": "bearer",
		"bearer": [
			{
				"key": "token",
				"value": "{{token}}",
				"type": "string"
			}
		]
	},
	"event": [
		{
			"listen": "prerequest",
			"script": {
				"type": "text/javascript",
				"exec": [
					"const url = pm.request.url.toString();",
					"const isLogin = url.includes('/auth/login');",
					"const missing = [];",
					"if (!isLogin && !pm.collectionVariables.get('token')) missing.push('token (run \"1. Auth / Login\" first)');",
					"if (url.includes('{{game_id}}') && !pm.collectionVariables.get('game_id')) missing.push('game_id (run \"2. Discovery / List games\" first)');",
					"if (url.includes('{{level_id}}') && !pm.collectionVariables.get('level_id')) missing.push('level_id (run \"2. Discovery / List levels\" first)');",
					"if (url.includes('{{item_id_') && !pm.collectionVariables.get('item_id_0')) missing.push('item_ids (run \"2. Discovery / Get level with items\" first)');",
					"if (missing.length) console.warn('[Find the Wrong Player] Missing variables:\\n - ' + missing.join('\\n - '));"
				]
			}
		}
	],
	"variable": [
		{ "key": "base_url", "value": "http://localhost:3000", "type": "string" },
		{ "key": "email", "value": "player@example.com", "type": "string" },
		{ "key": "password", "value": "password", "type": "string" },
		{ "key": "token", "value": "", "type": "string" },
		{ "key": "game_id", "value": "", "type": "string" },
		{ "key": "level_id", "value": "", "type": "string" },
		{ "key": "item_id_0", "value": "", "type": "string" },
		{ "key": "item_id_1", "value": "", "type": "string" },
		{ "key": "item_id_2", "value": "", "type": "string" },
		{ "key": "item_id_3", "value": "", "type": "string" }
	],
	"item": [
		{
			"name": "1. Auth",
			"item": [
				{
					"name": "Login (save token)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('200 OK', () => pm.response.to.have.status(200));",
									"const data = pm.response.json();",
									"pm.test('has access_token', () => pm.expect(data.access_token).to.be.a('string').and.not.empty);",
									"pm.collectionVariables.set('token', data.access_token);",
									"console.log('Token saved.');"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": { "type": "noauth" },
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Accept", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/auth/login",
							"host": ["{{base_url}}"],
							"path": ["api", "auth", "login"]
						}
					}
				}
			]
		},
		{
			"name": "2. Discovery",
			"item": [
				{
					"name": "List games (save find_the_wrong id)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('200 OK', () => pm.response.to.have.status(200));",
									"const list = pm.response.json();",
									"const games = Array.isArray(list) ? list : (list.data || []);",
									"const ftw = games.find(g => g.key === 'find_the_wrong');",
									"pm.test('find_the_wrong game exists', () => pm.expect(ftw).to.exist);",
									"if (ftw) {",
									"  pm.collectionVariables.set('game_id', String(ftw.id));",
									"  console.log('Saved game_id =', ftw.id);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [{ "key": "Accept", "value": "application/json" }],
						"url": {
							"raw": "{{base_url}}/api/games",
							"host": ["{{base_url}}"],
							"path": ["api", "games"]
						}
					}
				},
				{
					"name": "List levels (save first level id)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('200 OK', () => pm.response.to.have.status(200));",
									"const list = pm.response.json();",
									"const levels = Array.isArray(list) ? list : (list.data || []);",
									"pm.test('at least one level', () => pm.expect(levels.length).to.be.greaterThan(0));",
									"if (levels.length) {",
									"  pm.collectionVariables.set('level_id', String(levels[0].id));",
									"  console.log('Saved level_id =', levels[0].id);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [{ "key": "Accept", "value": "application/json" }],
						"url": {
							"raw": "{{base_url}}/api/games/{{game_id}}/levels",
							"host": ["{{base_url}}"],
							"path": ["api", "games", "{{game_id}}", "levels"]
						}
					}
				},
				{
					"name": "Get level with items (save item ids)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('200 OK', () => pm.response.to.have.status(200));",
									"const body = pm.response.json();",
									"// Items may be nested under `items` or at root level depending on the Resource.",
									"const items = body.items || body.data?.items || [];",
									"pm.test('at least 4 items', () => pm.expect(items.length).to.be.greaterThan(3));",
									"[0, 1, 2, 3].forEach(i => {",
									"  if (items[i]) {",
									"    pm.collectionVariables.set('item_id_' + i, String(items[i].id));",
									"    console.log('Saved item_id_' + i + ' =', items[i].id);",
									"  }",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [{ "key": "Accept", "value": "application/json" }],
						"url": {
							"raw": "{{base_url}}/api/games/{{game_id}}/levels/{{level_id}}",
							"host": ["{{base_url}}"],
							"path": ["api", "games", "{{game_id}}", "levels", "{{level_id}}"]
						}
					}
				}
			]
		},
		{
			"name": "3. Happy Path",
			"item": [
				{
					"name": "Submit attempt — 3 found, 1 missed",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('200 OK', () => pm.response.to.have.status(200));",
									"const body = pm.response.json();",
									"pm.test('has score', () => pm.expect(body.score).to.be.a('number'));",
									"pm.test('has total_questions', () => pm.expect(body.total_questions).to.be.a('number'));",
									"pm.test('score = 3', () => pm.expect(body.score).to.equal(3));",
									"pm.test('total_questions = 4', () => pm.expect(body.total_questions).to.equal(4));",
									"pm.test('found_items count = 3', () => pm.expect(body.found_items).to.have.lengthOf(3));",
									"pm.test('missed_items count = 1', () => pm.expect(body.missed_items).to.have.lengthOf(1));",
									"",
									"const found0 = body.found_items[0];",
									"pm.test('found item has id, stars, name, explanation', () => {",
									"  pm.expect(found0).to.have.property('id');",
									"  pm.expect(found0).to.have.property('stars');",
									"  pm.expect(found0).to.have.property('name');",
									"  pm.expect(found0).to.have.property('explanation');",
									"});",
									"pm.test('found item stars = 3', () => pm.expect(found0.stars).to.equal(3));",
									"",
									"const missed0 = body.missed_items[0];",
									"pm.test('missed item has no stars key', () => pm.expect(missed0).to.not.have.property('stars'));",
									"pm.test('missed item has id, name, explanation', () => {",
									"  pm.expect(missed0).to.have.property('id');",
									"  pm.expect(missed0).to.have.property('name');",
									"  pm.expect(missed0).to.have.property('explanation');",
									"});",
									"",
									"console.log('Score:', body.score, '/', body.total_questions);"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Accept", "value": "application/json" },
							{ "key": "Accept-Language", "value": "en" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"duration_seconds\": 42,\n  \"found\": [\n    { \"item_id\": {{item_id_0}}, \"stars\": 3 },\n    { \"item_id\": {{item_id_1}}, \"stars\": 2 },\n    { \"item_id\": {{item_id_2}}, \"stars\": 1 }\n  ],\n  \"missed_item_ids\": [ {{item_id_3}} ]\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/games/{{game_id}}/levels/{{level_id}}/attempts",
							"host": ["{{base_url}}"],
							"path": ["api", "games", "{{game_id}}", "levels", "{{level_id}}", "attempts"]
						}
					}
