									"const ids = JSON.parse(pm.collectionVariables.get('all_item_ids') || '[]');",
									"if (ids.length === 0) throw new Error('No item IDs — run Discovery first');",
									"// Same id appears in both `found` and `missed_item_ids`.",
									"const firstId = ids[0];",
									"pm.variables.set('request_payload', JSON.stringify({",
									"  duration_seconds: 10,",
									"  found: [{ item_id: firstId, stars: 3 }],",
									"  missed_item_ids: ids,",
									"}));"
								],
								"type": "text/javascript"
							}
						},
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('422 Unprocessable', () => pm.response.to.have.status(422));",
									"const body = pm.response.json();",
									"pm.test('error on found', () => pm.expect(body.errors).to.have.property('found'));"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Accept", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{{request_payload}}"
						},
						"url": {
							"raw": "{{base_url}}/api/games/{{ftwp_game_id}}/levels/{{ftwp_level_id}}/attempts",
							"host": ["{{base_url}}"],
							"path": ["api", "games", "{{ftwp_game_id}}", "levels", "{{ftwp_level_id}}", "attempts"]
						}
					}
				},
				{
					"name": "422 — duplicate item_id in found",
					"event": [
						{
							"listen": "prerequest",
							"script": {
								"exec": [
									"const ids = JSON.parse(pm.collectionVariables.get('all_item_ids') || '[]');",
									"if (ids.length === 0) throw new Error('No item IDs — run Discovery first');",
									"// First id duplicated in `found` — triggers distinct violation.",
									"const firstId = ids[0];",
									"const found = [",
									"  { item_id: firstId, stars: 3 },",
									"  { item_id: firstId, stars: 1 },",
									"];",
									"pm.variables.set('request_payload', JSON.stringify({",
									"  duration_seconds: 10,",
									"  found,",
									"  missed_item_ids: [],",
									"}));"
								],
								"type": "text/javascript"
							}
						},
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('422 Unprocessable', () => pm.response.to.have.status(422));",
									"const body = pm.response.json();",
									"pm.test('error on duplicate found.*.item_id', () => {",
									"  const errors = body.errors || {};",
									"  const hasDup = Object.keys(errors).some(k => k.startsWith('found.') && k.endsWith('.item_id'));",
									"  pm.expect(hasDup).to.be.true;",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Accept", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{{request_payload}}"
						},
						"url": {
							"raw": "{{base_url}}/api/games/{{ftwp_game_id}}/levels/{{ftwp_level_id}}/attempts",
							"host": ["{{base_url}}"],
							"path": ["api", "games", "{{ftwp_game_id}}", "levels", "{{ftwp_level_id}}", "attempts"]
						}
					}
				}
			]
		}
