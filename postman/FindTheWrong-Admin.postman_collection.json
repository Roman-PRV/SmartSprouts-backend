							"raw": "{}"
						},
						"url": {
							"raw": "{{base_url}}/api/admin/games/{{game_id}}/levels/{{level_id}}/items",
							"host": ["{{base_url}}"],
							"path": ["api", "admin", "games", "{{game_id}}", "levels", "{{level_id}}", "items"]
						}
					}
				}
			]
		},
		{
			"name": "5. Levels — Smoke",
			"item": [
				{
					"name": "List levels (admin)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('200 OK', () => pm.response.to.have.status(200));",
									"const list = pm.response.json();",
									"pm.test('array shape', () => pm.expect(list).to.be.an('array'));",
									"if (list[0]) {",
									"  pm.test('items_count field present', () => pm.expect(list[0]).to.have.property('items_count'));",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [{ "key": "Accept", "value": "application/json" }],
						"url": {
							"raw": "{{base_url}}/api/admin/games/{{game_id}}/levels",
							"host": ["{{base_url}}"],
							"path": ["api", "admin", "games", "{{game_id}}", "levels"]
						}
					}
				}
			]
		}
	]
