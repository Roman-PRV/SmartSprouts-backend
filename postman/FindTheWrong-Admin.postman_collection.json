									"pm.test('404 Not Found', () => pm.response.to.have.status(404));",
									"// GameMatches middleware fires before validation; payload doesn't matter"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Accept", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"polygon\": [[0.1,0.1],[0.4,0.1],[0.4,0.4]],\n  \"name\": { \"uk\": \"x\", \"en\": \"x\", \"es\": \"x\" }\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/admin/games/{{other_game_id}}/levels/{{level_id}}/items",
