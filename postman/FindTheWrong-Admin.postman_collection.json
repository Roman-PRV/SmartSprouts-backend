							"raw": "{\n  \"polygon\": [[0.1, 0.1], [0.4, 0.1], [0.4, 0.4]],\n  \"name\": { \"uk\": \"Тарілка\", \"en\": \"Plate\" }\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/admin/games/{{game_id}}/levels/{{level_id}}/items",
