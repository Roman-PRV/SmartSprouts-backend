					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('422 Unprocessable Entity', () => pm.response.to.have.status(422));",
									"const body = pm.response.json();",
									"pm.test('errors.polygon required', () => pm.expect(body.errors.polygon).to.exist);",
									"pm.test('errors.name required', () => pm.expect(body.errors.name).to.exist);"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
