{
	"info": {
		"_postman_id": "a7c4e1b0-9d32-4f58-8b21-6e0a4c9d7f10",
		"name": "Auth",
		"description": "Precondition: `admin_email`/`admin_password` and `user_email`/`user_password` must already exist as real accounts in the target DB before running `1. Tokens` (the admin one needs `is_admin = true`) — no seeder creates them; create them manually (or via the app's own register flow) or point the env vars at accounts you already have.\n\nCross-cutting authentication smoke tests: token issuance (admin + user), registration, logout revocation, and Google OAuth entry points.\n\nUsage:\n1. Select the `SmartSprouts — Local` environment.\n2. Run `1. Tokens` — `admin_token` and `user_token` are saved for every other collection to reuse.\n3. The remaining folders are independent (register / negatives / OAuth / logout use throwaway tokens and never touch the shared ones).\n\nMatches routes/api.php: throttle:auth-register on register, throttle:auth-login on login, throttle:auth-oauth-callback on the Google callback.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "1. Tokens",
			"item": [
				{
					"name": "Login as admin (save admin_token)",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('200 OK', () => pm.response.to.have.status(200));",
									"const data = pm.response.json();",
									"pm.test('has access_token', () => pm.expect(data.access_token).to.be.a('string').and.not.empty);",
									"pm.environment.set('admin_token', data.access_token);",
									"console.log('admin_token saved');"
								]
							}
						}
					],
					"request": {
						"auth": { "type": "noauth" },
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Accept", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"{{admin_email}}\",\n  \"password\": \"{{admin_password}}\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/auth/login",
							"host": ["{{base_url}}"],
							"path": ["api", "auth", "login"]
						}
					}
				},
				{
					"name": "Login as user (save user_token)",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('200 OK', () => pm.response.to.have.status(200));",
									"const data = pm.response.json();",
									"pm.test('has access_token', () => pm.expect(data.access_token).to.be.a('string').and.not.empty);",
									"pm.environment.set('user_token', data.access_token);",
									"console.log('user_token saved');"
								]
							}
						}
					],
					"request": {
						"auth": { "type": "noauth" },
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Accept", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"{{user_email}}\",\n  \"password\": \"{{user_password}}\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/auth/login",
							"host": ["{{base_url}}"],
							"path": ["api", "auth", "login"]
						}
					}
				},
				{
					"name": "Who am I — admin (is_admin true)",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('200 OK', () => pm.response.to.have.status(200));",
									"const user = pm.response.json().user;",
									"pm.test('is_admin true', () => pm.expect(user.is_admin).to.be.true);"
								]
							}
						}
					],
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [{ "key": "token", "value": "{{admin_token}}", "type": "string" }]
						},
						"method": "GET",
						"header": [{ "key": "Accept", "value": "application/json" }],
						"url": {
							"raw": "{{base_url}}/api/auth/me",
							"host": ["{{base_url}}"],
							"path": ["api", "auth", "me"]
						}
					}
				},
				{
					"name": "Who am I — user (is_admin false)",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('200 OK', () => pm.response.to.have.status(200));",
									"const user = pm.response.json().user;",
									"pm.test('is_admin false', () => pm.expect(user.is_admin).to.be.false);"
								]
							}
						}
					],
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [{ "key": "token", "value": "{{user_token}}", "type": "string" }]
						},
						"method": "GET",
						"header": [{ "key": "Accept", "value": "application/json" }],
						"url": {
							"raw": "{{base_url}}/api/auth/me",
							"host": ["{{base_url}}"],
							"path": ["api", "auth", "me"]
						}
					}
				}
			]
		},
		{
			"name": "2. Register",
			"item": [
				{
					"name": "Register new user (201)",
					"event": [
						{
							"listen": "prerequest",
							"script": {
								"type": "text/javascript",
								"exec": [
									"// Unique email per run so the happy path never collides with unique:users.",
									"pm.variables.set('fresh_email', 'newuser+' + Date.now() + '@example.com');"
								]
							}
						},
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('201 Created', () => pm.response.to.have.status(201));",
									"const data = pm.response.json();",
									"pm.test('has access_token', () => pm.expect(data.access_token).to.be.a('string').and.not.empty);",
									"pm.test('token_type Bearer', () => pm.expect(data.token_type).to.equal('Bearer'));",
									"pm.test('user echoed', () => pm.expect(data.user.email).to.be.a('string'));"
								]
							}
						}
					],
					"request": {
						"auth": { "type": "noauth" },
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Accept", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"New User\",\n  \"email\": \"{{fresh_email}}\",\n  \"password\": \"Password123\",\n  \"password_confirmation\": \"Password123\",\n  \"accepted_terms\": true\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/auth/register",
							"host": ["{{base_url}}"],
							"path": ["api", "auth", "register"]
						}
					}
				},
				{
					"name": "Register — duplicate email (422)",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('422 Unprocessable Entity', () => pm.response.to.have.status(422));",
									"pm.test('email error present', () => pm.expect(pm.response.json().errors.email).to.exist);"
								]
							}
						}
					],
					"request": {
						"auth": { "type": "noauth" },
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Accept", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"Dup\",\n  \"email\": \"{{admin_email}}\",\n  \"password\": \"Password123\",\n  \"password_confirmation\": \"Password123\",\n  \"accepted_terms\": true\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/auth/register",
							"host": ["{{base_url}}"],
							"path": ["api", "auth", "register"]
						}
					}
				},
				{
					"name": "Register — terms not accepted (422)",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('422 Unprocessable Entity', () => pm.response.to.have.status(422));",
									"pm.test('accepted_terms error present', () => pm.expect(pm.response.json().errors.accepted_terms).to.exist);"
								]
							}
						}
					],
					"request": {
						"auth": { "type": "noauth" },
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Accept", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"No Terms\",\n  \"email\": \"noterms+{{$timestamp}}@example.com\",\n  \"password\": \"Password123\",\n  \"password_confirmation\": \"Password123\",\n  \"accepted_terms\": false\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/auth/register",
							"host": ["{{base_url}}"],
							"path": ["api", "auth", "register"]
						}
					}
				},
				{
					"name": "Register — weak password (422)",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('422 Unprocessable Entity', () => pm.response.to.have.status(422));",
									"pm.test('password error present', () => pm.expect(pm.response.json().errors.password).to.exist);"
								]
							}
						}
					],
					"request": {
						"auth": { "type": "noauth" },
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Accept", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"Weak\",\n  \"email\": \"weak+{{$timestamp}}@example.com\",\n  \"password\": \"weak\",\n  \"password_confirmation\": \"weak\",\n  \"accepted_terms\": true\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/auth/register",
							"host": ["{{base_url}}"],
							"path": ["api", "auth", "register"]
						}
					}
				}
			]
		},
		{
			"name": "3. Negative",
			"item": [
				{
					"name": "Login — wrong password (401)",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('401 Unauthorized', () => pm.response.to.have.status(401));",
									"pm.test('message present', () => pm.expect(pm.response.json().message).to.be.a('string'));"
								]
							}
						}
					],
					"request": {
						"auth": { "type": "noauth" },
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Accept", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"{{user_email}}\",\n  \"password\": \"definitely-wrong\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/auth/login",
							"host": ["{{base_url}}"],
							"path": ["api", "auth", "login"]
						}
					}
				},
				{
					"name": "Who am I — no token (401)",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('401 Unauthorized', () => pm.response.to.have.status(401));"
								]
							}
						}
					],
					"request": {
						"auth": { "type": "noauth" },
						"method": "GET",
						"header": [{ "key": "Accept", "value": "application/json" }],
						"url": {
							"raw": "{{base_url}}/api/auth/me",
							"host": ["{{base_url}}"],
							"path": ["api", "auth", "me"]
						}
					}
				}
			]
		},
		{
			"name": "4. Google OAuth",
			"item": [
				{
					"name": "Google redirect (returns provider URL)",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"// Socialite builds the Google consent URL. Depending on config this is a",
									"// 200 JSON { url } or a 302 to accounts.google.com — accept either.",
									"pm.test('200 or 302', () => pm.expect([200, 302]).to.include(pm.response.code));"
								]
							}
						}
					],
					"request": {
						"auth": { "type": "noauth" },
						"method": "GET",
						"header": [{ "key": "Accept", "value": "application/json" }],
						"url": {
							"raw": "{{base_url}}/api/auth/google/redirect",
							"host": ["{{base_url}}"],
							"path": ["api", "auth", "google", "redirect"]
						}
					}
				},
				{
					"name": "Google callback — no code (error, not 200)",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"// Full OAuth needs a real provider code; here we only assert the endpoint",
									"// exists and rejects an empty/invalid callback rather than succeeding.",
									"pm.test('not a success', () => pm.expect(pm.response.code).to.be.at.least(300));"
								]
							}
						}
					],
					"request": {
						"auth": { "type": "noauth" },
						"method": "GET",
						"header": [{ "key": "Accept", "value": "application/json" }],
						"url": {
							"raw": "{{base_url}}/api/auth/google/callback",
							"host": ["{{base_url}}"],
							"path": ["api", "auth", "google", "callback"]
						}
					}
				}
			]
		},
		{
			"name": "5. Logout (revocation)",
			"item": [
				{
					"name": "Register throwaway (save temp_token)",
					"event": [
						{
							"listen": "prerequest",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.variables.set('temp_email', 'logout+' + Date.now() + '@example.com');"
								]
							}
						},
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('201 Created', () => pm.response.to.have.status(201));",
									"pm.collectionVariables.set('temp_token', pm.response.json().access_token);"
								]
							}
						}
					],
					"request": {
						"auth": { "type": "noauth" },
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Accept", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"Logout Probe\",\n  \"email\": \"{{temp_email}}\",\n  \"password\": \"Password123\",\n  \"password_confirmation\": \"Password123\",\n  \"accepted_terms\": true\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/auth/register",
							"host": ["{{base_url}}"],
							"path": ["api", "auth", "register"]
						}
					}
				},
				{
					"name": "Logout throwaway (200)",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('200 OK', () => pm.response.to.have.status(200));"
								]
							}
						}
					],
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [{ "key": "token", "value": "{{temp_token}}", "type": "string" }]
						},
						"method": "POST",
						"header": [{ "key": "Accept", "value": "application/json" }],
						"url": {
							"raw": "{{base_url}}/api/auth/logout",
							"host": ["{{base_url}}"],
							"path": ["api", "auth", "logout"]
						}
					}
				},
				{
					"name": "Reuse revoked token (401)",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('401 Unauthorized', () => pm.response.to.have.status(401));"
								]
							}
						}
					],
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [{ "key": "token", "value": "{{temp_token}}", "type": "string" }]
						},
						"method": "GET",
						"header": [{ "key": "Accept", "value": "application/json" }],
						"url": {
							"raw": "{{base_url}}/api/auth/me",
							"host": ["{{base_url}}"],
							"path": ["api", "auth", "me"]
						}
					}
				}
			]
		}
	],
	"variable": [{ "key": "temp_token", "value": "", "type": "string" }]
}
