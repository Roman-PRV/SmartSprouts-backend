MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=laravel
MYSQL_USER=laravel
MYSQL_PASSWORD=your_secure_mysql_password_here

# Host port for MySQL (default: 3306). Change this, not the internal port in
# docker-compose.yml, if something else on your machine already holds 3306.
MYSQL_PORT=3306

REDIS_PASSWORD=your_secure_redis_password_here

# Host port for Redis — exposed only in development (default: 6379).
# Not published in production: the base docker-compose.yml only `expose`s it
# internally; the host port mapping below lives in docker-compose.override.yml,
# which is dev-only.
REDIS_PORT=6379

TTS_PORT=5001

# Application environment.
# Controls Laravel operating mode AND triggers auto-migrations on container start.
#
#   local       — Development. Xdebug enabled. Migrations NOT run automatically.
#   production  — Production. Xdebug disabled. `php artisan migrate --force`
#                 runs automatically on every container start.
#
# This value is overridden by docker-compose.override.yml locally. In
# production there is no committed override — Coolify injects it directly
# via its UI. You only need to set it manually when running the container
# standalone.
APP_ENV=local

# Text-To-Speech (TTS)
TTS_MAX_TEXT_LENGTH=2000
TTS_CHUNK_SIZE=200